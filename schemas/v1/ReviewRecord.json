{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/ID"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ID": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ID",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "OPEN",
        "ACCEPTED",
        "REVISE",
        "REJECTED"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dissent": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Dissent",
      "type": "array"
    },
    "findings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "review_id": {
      "$ref": "#/$defs/ID"
    },
    "reviewer": {
      "$ref": "#/$defs/Actor"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus"
    }
  },
  "required": [
    "occurred_at",
    "review_id",
    "reviewer",
    "status"
  ],
  "title": "ReviewRecord",
  "type": "object"
}

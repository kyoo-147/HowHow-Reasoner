{
  "$defs": {
    "ID": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ID",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "$ref": "#/$defs/ID"
    },
    "completed": {
      "default": false,
      "title": "Completed",
      "type": "boolean"
    },
    "content_sha256": {
      "title": "Content Sha256",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "parents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ID"
      },
      "title": "Parents",
      "type": "array"
    },
    "portable_path": {
      "title": "Portable Path",
      "type": "string"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "occurred_at",
    "artifact_id",
    "media_type",
    "content_sha256",
    "producer",
    "portable_path"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}

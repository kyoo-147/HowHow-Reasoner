{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/ID"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "kind"
      ],
      "title": "Actor",
      "type": "object"
    },
    "ID": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ID",
      "type": "object"
    },
    "RecordStatus": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "REJECTED",
        "INCONCLUSIVE",
        "CANCELLED",
        "BLOCKED"
      ],
      "title": "RecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "approval_id": {
      "$ref": "#/$defs/ID"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "title": "Scope",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RecordStatus",
      "default": "APPROVED"
    }
  },
  "required": [
    "occurred_at",
    "approval_id",
    "actor",
    "scope"
  ],
  "title": "ApprovalRecord",
  "type": "object"
}

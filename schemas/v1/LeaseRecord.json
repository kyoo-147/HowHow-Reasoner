{
  "$defs": {
    "ID": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ID",
      "type": "object"
    },
    "ProviderIdentity": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "minLength": 1,
          "title": "Provider Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "provider_kind",
        "implementation",
        "version"
      ],
      "title": "ProviderIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "fencing_token": {
      "title": "Fencing Token",
      "type": "string"
    },
    "lease_id": {
      "$ref": "#/$defs/ID"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/ProviderIdentity"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "occurred_at",
    "lease_id",
    "task_id",
    "provider",
    "attempt",
    "fencing_token",
    "expires_at"
  ],
  "title": "LeaseRecord",
  "type": "object"
}

{
  "$defs": {
    "ID": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ID",
      "type": "object"
    },
    "ProviderIdentity": {
      "additionalProperties": false,
      "properties": {
        "implementation": {
          "minLength": 1,
          "title": "Implementation",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "minLength": 1,
          "title": "Provider Kind",
          "type": "string"
        },
        "schema_version": {
          "default": "v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "provider_kind",
        "implementation",
        "version"
      ],
      "title": "ProviderIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ID"
      },
      "title": "Evidence",
      "type": "array"
    },
    "provider": {
      "$ref": "#/$defs/ProviderIdentity"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "provider",
    "status",
    "checked_at"
  ],
  "title": "ProviderReadiness",
  "type": "object"
}

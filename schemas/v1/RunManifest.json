{
  "$defs": {
    "ID": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ID",
      "type": "object"
    },
    "RecordStatus": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "REJECTED",
        "INCONCLUSIVE",
        "CANCELLED",
        "BLOCKED"
      ],
      "title": "RecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ID"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "code_revision": {
      "title": "Code Revision",
      "type": "string"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "title": "Command",
      "type": "array"
    },
    "completed": {
      "default": false,
      "title": "Completed",
      "type": "boolean"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "run_id": {
      "$ref": "#/$defs/ID"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "status": {
      "$ref": "#/$defs/RecordStatus"
    },
    "task_id": {
      "$ref": "#/$defs/ID"
    }
  },
  "required": [
    "occurred_at",
    "run_id",
    "task_id",
    "code_revision",
    "command",
    "status"
  ],
  "title": "RunManifest",
  "type": "object"
}

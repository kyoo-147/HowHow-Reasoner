{
  "$defs": {
    "ID": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ID",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allow_network": {
      "default": false,
      "title": "Allow Network",
      "type": "boolean"
    },
    "hash": {
      "minLength": 1,
      "title": "Hash",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "permissions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Permissions",
      "type": "array"
    },
    "policy_id": {
      "$ref": "#/$defs/ID"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "occurred_at",
    "policy_id",
    "name",
    "hash"
  ],
  "title": "PolicySnapshot",
  "type": "object"
}

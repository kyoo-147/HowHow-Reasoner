{
  "$defs": {
    "ID": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "ID",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "limit": {
      "minimum": 0,
      "title": "Limit",
      "type": "number"
    },
    "reservation_id": {
      "$ref": "#/$defs/ID"
    },
    "resource": {
      "title": "Resource",
      "type": "string"
    },
    "schema_version": {
      "default": "v1",
      "title": "Schema Version",
      "type": "string"
    },
    "spent": {
      "default": 0,
      "minimum": 0,
      "title": "Spent",
      "type": "number"
    }
  },
  "required": [
    "reservation_id",
    "resource",
    "limit"
  ],
  "title": "BudgetReservation",
  "type": "object"
}

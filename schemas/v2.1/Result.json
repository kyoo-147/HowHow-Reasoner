{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-schema-v2.1",
  "type": "object",
  "required": ["schema_version", "protocol_version", "status", "hashes", "state"],
  "properties": {
    "schema_version": {"const": "result-schema-v2.1"},
    "protocol_version": {"const": "protocol-v2.1"},
    "status": {"enum": ["COMPLETE", "FAILED", "NOT_ESTIMABLE", "INCOMPLETE_FAMILY"]},
    "state": {"type": "string"},
    "hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-schema-v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "status", "state", "scope", "provenance", "hashes", "support", "estimability", "population", "pairing", "family", "outputs", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "result-schema-v2.1"},
    "protocol_version": {"const": "protocol-v2.1"},
    "status": {"enum": ["COMPLETE", "FAILED", "NOT_ESTIMABLE", "INCOMPLETE_FAMILY"]},
    "state": {"enum": ["DECLARED", "PREFLIGHT_PASS", "LOADED", "TRAINING_PASS", "INNER_CALIBRATION_PASS", "OUTER_TEST_OBSERVED", "METRICS_READY", "AGGREGATED", "INFERENTIAL_READY", "COMPLETE", "FAILED", "NOT_ESTIMABLE", "INCOMPLETE_FAMILY"]},
    "scope": {"enum": ["run", "configuration", "state", "subject", "fold", "estimand", "family"]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "reason": {"type": "string"},
    "required_fields_missing": {"type": "array", "items": {"type": "string"}},
    "hashes": {"$ref": "#/$defs/hashes"},
    "support": {"type": "object", "additionalProperties": false, "required": ["training", "inner_calibration", "held_out_test"], "properties": {"training": {"$ref": "#/$defs/fitting_support"}, "inner_calibration": {"$ref": "#/$defs/fitting_support"}, "held_out_test": {"$ref": "#/$defs/test_support"}}},
    "estimability": {"type": "object", "additionalProperties": false, "required": ["nll", "brier", "ece"], "properties": {"nll": {"$ref": "#/$defs/estimability"}, "brier": {"$ref": "#/$defs/estimability"}, "ece": {"$ref": "#/$defs/estimability"}}},
    "population": {"type": "object", "additionalProperties": false, "required": ["frozen_subject_ids", "exclusions", "population_rule_id", "eligibility_manifest_hash"], "properties": {"frozen_subject_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}, "population_rule_id": {"type": "string", "minLength": 1}, "eligibility_manifest_hash": {"$ref": "#/$defs/hash"}}},
    "pairing": {"type": "object", "additionalProperties": false, "required": ["pairing_manifest_hash", "eligible_subject_hash", "records"], "properties": {"pairing_manifest_hash": {"$ref": "#/$defs/hash"}, "eligible_subject_hash": {"$ref": "#/$defs/hash"}, "records": {"type": "array", "items": {"$ref": "#/$defs/pairing_record"}}}},
    "family": {"type": "object", "additionalProperties": false, "required": ["family_id", "hypotheses", "alpha", "m", "status"], "properties": {"family_id": {"const": "v2-primary-calibrated-vs-uncalibrated-3"}, "hypotheses": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/hypothesis"}}, "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "m": {"const": 3}, "status": {"enum": ["COMPLETE", "INCOMPLETE_FAMILY"]}}},
    "outputs": {"type": "object", "additionalProperties": false, "required": ["generator", "manuscript"], "properties": {"generator": {"type": "string"}, "manuscript": {"type": "string"}}},
    "claim_boundary": {"const": "synthetic_structural_only_no_performance_claim"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["proposal_sha256", "decision_sha256", "review_revision", "allow_code_fix", "allow_rerun"], "properties": {"proposal_sha256": {"const": "17cfe84a5096ce1025f13cce779e34a55ab459f408168c899b2de05b2c339b08"}, "decision_sha256": {"const": "7469a71ac40a002595a0e2a5d241a62ddd8278cb5bb507a529a2fb579d12061c"}, "review_revision": {"const": 4}, "allow_code_fix": {"const": true}, "allow_rerun": {"const": false}}},
    "hashes": {"type": "object", "additionalProperties": false, "required": ["protocol_sha256", "schema_sha256", "config_sha256", "code_sha256", "input_sha256", "vocabulary_sha256", "eligibility_manifest_sha256", "pairing_manifest_sha256"], "properties": {"protocol_sha256": {"$ref": "#/$defs/hash"}, "schema_sha256": {"$ref": "#/$defs/hash"}, "config_sha256": {"$ref": "#/$defs/hash"}, "code_sha256": {"$ref": "#/$defs/hash"}, "input_sha256": {"$ref": "#/$defs/hash"}, "vocabulary_sha256": {"$ref": "#/$defs/hash"}, "eligibility_manifest_sha256": {"$ref": "#/$defs/hash"}, "pairing_manifest_sha256": {"$ref": "#/$defs/hash"}}},
    "fitting_support": {"type": "object", "additionalProperties": false, "required": ["stage", "counts", "minimum", "status", "reason", "failed_classes"], "properties": {"stage": {"enum": ["training", "inner_calibration"]}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "minimum": {"type": "integer", "minimum": 1}, "status": {"enum": ["PASS", "FAILED"]}, "reason": {"type": ["string", "null"]}, "failed_classes": {"type": "array", "items": {"type": "string"}}}},
    "test_support": {"type": "object", "additionalProperties": false, "required": ["stage", "counts", "status", "class_status", "zero_support", "aggregate_metrics_allowed"], "properties": {"stage": {"const": "held_out_test"}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "status": {"const": "OUTER_TEST_OBSERVED"}, "class_status": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["status", "support"], "properties": {"status": {"enum": ["OBSERVED", "NOT_ESTIMABLE"]}, "support": {"type": "integer", "minimum": 0}, "reason": {"const": "ZERO_SUPPORT"}}}}, "zero_support": {"type": "array", "items": {"type": "string"}}, "aggregate_metrics_allowed": {"const": true}}},
    "estimability": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["ESTIMABLE", "NOT_ESTIMABLE"]}, "reason": {"type": "string"}, "value": {"type": "number", "minimum": 0}}},
    "exclusion": {"type": "object", "additionalProperties": false, "required": ["subject_id", "reason"], "properties": {"subject_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}},
    "pairing_record": {"type": "object", "additionalProperties": false, "required": ["subject_id", "contrast_id", "estimand_id", "reason", "arm", "window_set_hash", "population_rule_id"], "properties": {"subject_id": {"type": "string", "minLength": 1}, "contrast_id": {"type": "string", "minLength": 1}, "estimand_id": {"enum": ["nll", "brier", "ece"]}, "reason": {"enum": ["", "ZERO_WINDOWS", "STAGE_FAILURE", "WINDOW_ID_MISMATCH", "ESTIMAND_NOT_ESTIMABLE"]}, "arm": {"enum": ["calibrated", "uncalibrated"]}, "window_set_hash": {"$ref": "#/$defs/hash"}, "population_rule_id": {"type": "string", "minLength": 1}}},
    "hypothesis": {"type": "object", "additionalProperties": false, "required": ["identifier", "raw_p", "sorted_rank", "equality_tie_group", "threshold", "raw_holm", "adjusted_p", "local_pass", "final_reject", "stop_rank"], "properties": {"identifier": {"enum": ["H_NLL", "H_BRIER", "H_ECE"]}, "raw_p": {"type": "number", "minimum": 0, "maximum": 1}, "sorted_rank": {"type": "integer", "minimum": 1, "maximum": 3}, "equality_tie_group": {"type": "integer", "minimum": 1, "maximum": 3}, "threshold": {"type": "number", "minimum": 0, "maximum": 1}, "raw_holm": {"type": "number", "minimum": 0, "maximum": 1}, "adjusted_p": {"type": "number", "minimum": 0, "maximum": 1}, "local_pass": {"type": "boolean"}, "final_reject": {"type": "boolean"}, "stop_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 3}}}
  }
}
